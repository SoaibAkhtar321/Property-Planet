+/* ===================================================================
+   Phase 7 — Buyer / User Panel Dark Mode
+   Adds the missing --pp-* dark-mode coverage for the dashboard shell,
+   sidebar, tables, message center and modals. Nothing here changes a
+   single light-mode value -- every rule is scoped under
+   [data-theme="dark"] and layered on top of the existing selectors
+   above, following the same pattern already used elsewhere in this
+   file (e.g. .dash-btn-two, .filter-input).
+=================================================================== */
+[data-theme="dark"] {
+    // ---- Sidebar ----
+    // Phase 11: the background here is dead code -- _theme.scss's
+    // "Dashboard / admin shared surfaces" block already forces
+    // `.dash-aside-navbar { background-color: var(--pp-surface) !important; }`
+    // (from the Phase 6 admin work; admin and buyer share this same
+    // component/class), so this non-!important declaration never once
+    // applied over it. Removed rather than left as duplicate, unused code.
+    .dash-aside-navbar {
+        box-shadow: none;
+        border-right: 1px solid var(--pp-border);
+
+        &::-webkit-scrollbar-track { background: var(--pp-surface); }
+        &::-webkit-scrollbar-thumb { background: var(--pp-border-strong); }
+
+        .bottom-line { border-color: var(--pp-border); }
+
+        .dasboard-main-nav li a {
+            color: var(--pp-text-strong);
+
+            &.active {
+                background: var(--pp-surface-2);
+                color: var(--pp-text-strong);
+            }
+        }
+        .dasboard-main-nav li .nav-title {
+            color: var(--pp-text-muted);
+        }
+        .profile-complete-status {
+            .progress-value { color: var(--pp-text-strong); }
+            .progress-line { background: var(--pp-border); }
+            p { color: var(--pp-text-muted); }
+        }
+        .logout-btn {
+            color: var(--pp-text-strong);
+            .icon { background: var(--pp-surface-2); }
+        }
+        .close-btn { color: var(--pp-text-strong); }
+    }
+
+    // ---- Body / header shell ----
+    // Phase 11: same dead-code situation as the sidebar above --
+    // _theme.scss already forces `.dashboard-body { background-color:
+    // var(--pp-surface) !important; }` and `.dashboard-header {
+    // background-color: var(--pp-header-bg) !important; ... }`, both of
+    // which always won over the plain `background: var(--pp-bg)` these
+    // two used to carry. Removed; every other rule below (which targets
+    // things _theme.scss's admin-era pass never touched) is unaffected.
+    .dashboard-body {
+        .dash-cancel-btn { color: var(--pp-text-strong); }
+
+        .dash-btn-one {
+            background: var(--pp-surface-2);
+            color: var(--pp-text-strong);
+        }
+
+        .dashboard-header {
+            .search-form input {
+                border-color: var(--pp-border-strong);
+                color: var(--pp-text-strong);
+            }
+            .user-data {
+                .user-avatar { border-color: var(--pp-surface-2); }
+                .user-avatar.online:before { border-color: var(--pp-surface); }
+            }
+            .profile-notification .dropdown-menu {
+                .notify-list li {
+                    h6 { color: var(--pp-text-muted); }
+                    &.unread h6 { color: var(--pp-text-strong); }
+                    .time { color: var(--pp-text-muted); }
+                }
+            }
+        }
+
+        // ---- Stat cards ----
+        .dash-card-one {
+            &:before { background: var(--pp-border); }
+            .icon { background: var(--pp-surface-2); }
+            .value { color: var(--pp-text-strong); }
+            span { color: var(--pp-text-muted); }
+        }
+
+        .recent-job-tab .wrapper .job-item-list {
+            .job-title .meta { color: var(--pp-text-muted); }
+            .job-action .dropdown-menu .dropdown-item { background: transparent; }
+        }
+
+        // ---- Profile / account forms ----
+        .user-avatar-setting .delete-btn { color: var(--pp-text-strong); }
+        .dash-input-wrapper {
+            input, textarea, .nice-select {
+                border-color: var(--pp-input-border);
+                background: var(--pp-input-bg);
+                color: var(--pp-text-strong);
+            }
+            .attached-file {
+                background: var(--pp-surface-2);
+                .remove-btn { color: var(--pp-text-strong); }
+            }
+            .skills-wrapper {
+                background: var(--pp-surface-2);
+                ul li.is_tag button {
+                    background: var(--pp-card-bg);
+                    color: var(--pp-text);
+                }
+            }
+            .info-text p { color: var(--pp-text-muted); }
+        }
+        .remove-portfolio-item {
+            background: var(--pp-surface-2);
+            color: var(--pp-text-strong);
+            &:hover { background: var(--pp-surface); }
+        }
+
+        // ---- Filters ----
+        .short-filter .nice-select { border-color: var(--pp-border-strong); }
+        .filter-input label {
+            color: var(--pp-text-strong);
+            &::before {
+                background: var(--pp-input-bg);
+                border-color: var(--pp-border-strong);
+            }
+        }
+
+        // ---- Tables (saved properties / saved searches) ----
+        .property-list-table,
+        .saved-search-table {
+            th {
+                background: var(--pp-surface-2);
+                color: var(--pp-text-strong);
+            }
+            td {
+                color: var(--pp-text);
+                border-bottom-color: var(--pp-border);
+
+                .address { color: var(--pp-text-muted); }
+            }
+            .btns-group a { color: var(--pp-text-strong); }
+        }
+
+        // ---- Message center ----
+        .new-message-compose { color: var(--pp-text-inverse); }
+        .message-pagination a,
+        .message-pagination span { color: var(--pp-text-strong); }
+
+        .message-wrapper {
+            .message-sidebar {
+                border-right-color: var(--pp-border);
+                .page-title { color: var(--pp-text-strong); }
+                .search-form input { border-color: var(--pp-border-strong); }
+                .message_filter button {
+                    color: var(--pp-text-strong);
+                    &.active { background: var(--pp-surface-2); }
+                }
+                .email-list-item {
+                    border-top-color: var(--pp-border);
+                    &.selected {
+                        background: var(--pp-surface-2);
+                        .email-short-preview .file { background: var(--pp-surface); }
+                    }
+                    .email-short-preview {
+                        .sender-name { color: var(--pp-text-muted); }
+                        .date { color: var(--pp-text-muted); }
+                        .mail-sub { color: var(--pp-text-strong); }
+                        .mail-text { color: var(--pp-text-muted); }
+                        .file {
+                            color: var(--pp-text-muted);
+                            background: var(--pp-surface-2);
+                        }
+                    }
+                }
+            }
+            .open-email-container {
+                .divider { border-bottom-color: var(--pp-border); }
+                .email-header {
+                    .sender-name { color: var(--pp-text-strong); }
+                    .sender-email { color: var(--pp-text-muted); }
+                    .time { color: var(--pp-text-muted); }
+                }
+                .email-body p a { color: var(--pp-text-strong); }
+                .email-footer .attachments .file {
+                    border-color: var(--pp-border);
+                    .icon { background: var(--pp-surface-2); }
+                    .file-name { color: var(--pp-text-strong); }
+                    .file-size { color: var(--pp-text-muted); }
+                }
+            }
+        }
+
+        // ---- Membership / plan ----
+        .membership-plan-wrapper {
+            border-color: var(--pp-border-strong);
+            .column.border-left { border-left-color: var(--pp-border-strong); }
+            h4 { color: var(--pp-text-strong); }
+            .text1 span { color: var(--pp-text-strong); }
+        }
+    }
+
+    // ---- Compose email / offcanvas / popups ----
+    .compose-new-email-container {
+        background: var(--pp-card-bg);
+        border-color: var(--pp-border);
+        .new-email-header {
+            border-bottom-color: var(--pp-border);
+            .btn-group a { color: var(--pp-text-strong); }
+        }
+        .compose-body-header .input-group { color: var(--pp-text-strong); }
+    }
+    .compose-mail-offcanvas {
+        background: var(--pp-card-bg);
+        border-color: var(--pp-border);
+        box-shadow: var(--pp-shadow);
+    }
+    .remove-account-popup {
+        background: var(--pp-card-bg);
+        h2 { color: var(--pp-text-strong); }
+        .btn-close { color: var(--pp-text-strong); }
+    }
+
+    // ---- Bootstrap component scoping (Phase B block above) ----
+    .dashboard-body {
+        .form-control,
+        .form-select {
+            background-color: var(--pp-input-bg);
+            border-color: var(--pp-input-border);
+            color: var(--pp-text-strong);
+
+            &::placeholder { color: var(--pp-text-muted); }
+            &:disabled,
+            &[readonly] {
+                background-color: var(--pp-surface-2);
+            }
+        }
+
+        .table {
+            background: var(--pp-card-bg);
+            box-shadow: none;
+
+            > thead th {
+                background: var(--pp-surface-2);
+                color: var(--pp-text-strong);
+            }
+            > tbody td {
+                color: var(--pp-text);
+                border-color: var(--pp-border);
+            }
+        }
+    }
+}
