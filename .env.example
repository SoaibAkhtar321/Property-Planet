# NOT CURRENTLY USED. PropertyPlanetMapIntelligence now renders the
# corridor map with Leaflet/OpenStreetMap (no key required), and
# property/project detail pages use a plain Google Maps *embed* iframe
# (https://maps.google.com/maps?...&output=embed), which also needs no
# API key. Left here, unset, only in case a future feature reintroduces
# the Google Maps JavaScript API — do not provision or restrict a key
# for this unless that happens.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Supabase -----------------------------------------------------------
# Project Settings - API in the Supabase dashboard.
# Safe for the browser (that's what NEXT_PUBLIC_ means) — RLS is what
# actually protects data, not keeping these two secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row Level Security entirely. Never prefix this with
# NEXT_PUBLIC_, never import it from a use client file, never log it, and
# never commit a real value — only ever set it in your serverhosting
# provider's environment variable settings (e.g. Vercel project env vars).
SUPABASE_SERVICE_ROLE_KEY=

# --- Hero video (home-two hero background) -------------------------------
# Optional. When BOTH desktop and mobile URLs are set, the hero renders a
# full-bleed background video (art-directed: 16:9 source for landscape
# viewports, 9:16 source for portrait viewports, chosen by aspect ratio at
# runtime). Leave both unset to keep the default animated-SVG hero — that
# is the fallback in every case (reduced-motion, video load failure, or
# these vars simply not configured).
NEXT_PUBLIC_HERO_VIDEO_DESKTOP_URL=
NEXT_PUBLIC_HERO_VIDEO_MOBILE_URL=
NEXT_PUBLIC_HERO_VIDEO_DESKTOP_POSTER=
NEXT_PUBLIC_HERO_VIDEO_MOBILE_POSTER=
