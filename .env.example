# Google Maps JavaScript API key, used by PropertyPlanetMapIntelligence
# (srccomponentshomeshome-twoPropertyPlanetMapIntelligence.tsx) to render the
# real corridor map. Create a key in Google Cloud Console with the Maps
# JavaScript API enabled, then restrict it to your domain(s).
# httpsconsole.cloud.google.comgooglemaps-apiscredentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Supabase -----------------------------------------------------------
# Project Settings - API in the Supabase dashboard.
# Safe for the browser (that's what NEXT_PUBLIC_ means) — RLS is what
# actually protects data, not keeping these two secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses Row Level Security entirely. Never prefix this with
# NEXT_PUBLIC_, never import it from a use client file, never log it, and
# never commit a real value — only ever set it in your serverhosting
# provider's environment variable settings (e.g. Vercel project env vars).
SUPABASE_SERVICE_ROLE_KEY=
