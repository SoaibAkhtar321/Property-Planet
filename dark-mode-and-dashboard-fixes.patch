+    --bs-table-hover-color: var(--pp-text-strong);
+    --bs-table-active-bg: var(--pp-surface-2);
+    --bs-table-active-color: var(--pp-text-strong);
+    --bs-table-border-color: var(--pp-border);
+    background-color: transparent;
     color: var(--pp-text);
 
     th {
