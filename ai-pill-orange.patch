From 543e9432af1dc590d5c6808ee9f51fb8618dc027 Mon Sep 17 00:00:00 2001
From: Soaib Akhtar <soaib@example.com>
Date: Sun, 13 Sep 2026 16:54:07 +0000
Subject: [PATCH] Add theme orange accents to the hero Ask Property Planet AI
 pill

- 'ASK' eyebrow label: gray -> theme orange (#FF6725)
- Icon circle: added a 2px orange ring border (previously only turned orange on hover)
---
 public/assets/scss/_banner.scss | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/public/assets/scss/_banner.scss b/public/assets/scss/_banner.scss
index 617359e..06768e6 100644
--- a/public/assets/scss/_banner.scss
+++ b/public/assets/scss/_banner.scss
@@ -63,6 +63,7 @@
             min-width: 52px;
             border-radius: 50%;
             background: linear-gradient(135deg, #0F2A37 0%, #23505F 100%);
+            border: 2px solid $color-one;
             display: flex;
             align-items: center;
             justify-content: center;
@@ -96,7 +97,7 @@
             font-weight: 500;
             letter-spacing: 2px;
             text-transform: uppercase;
-            color: rgba($color: #000000, $alpha: 0.45);
+            color: $color-one;
             line-height: 1.4;
         }
         &__title {
