+/* ============================================== HOMEPAGE SECTION BANDS === */
+/* Featured Opportunities, Explore Properties, How Property Planet Works and
+   Explore the Places with Most Properties used to sit on the plain white page
+   with no background of their own. Each is now a full-width tinted band that
+   alternates warm (brand orange/cream) and sky (the hero's blue), so the page
+   reads as a sequence of distinct sections instead of one long white sheet.
+   Vertical spacing moved from margin-top/padding-bottom utility classes on
+   each section into the band's own padding, so no white gap shows between
+   bands. Pure presentation: no content, data or behaviour changes. */
+/* `.pp-band.pp-band` (doubled) only raises specificity so the pseudo-element
+   rules below beat `.property-listing-two:before` in _listing.scss and
+   _responsive.scss, which are imported after this file. */
+.pp-band.pp-band {
+   position: relative;
+   isolation: isolate;
+   overflow: hidden;
+   padding: 110px 0;
+
+   /* Two soft colour glows per band; decorative only. Overrides
+      `.property-listing-two:before` (the old bottom-image overlay) where the
+      band shares that class. */
+   &::before,
+   &::after {
+      content: '';
+      position: absolute;
+      border-radius: 50%;
+      pointer-events: none;
+      z-index: -1;
+      background-repeat: no-repeat;
+      height: auto;
+      opacity: 1;
+   }
+   &::before {
+      width: 520px;
+      height: 520px;
+      top: -180px;
+      right: -140px;
+      left: auto;
+      bottom: auto;
+   }
+   &::after {
+      width: 460px;
+      height: 460px;
+      bottom: -200px;
+      left: -160px;
+   }
+
+   .title-one h2 {
+      position: relative;
+      padding-bottom: 18px;
+
+      /* Short orange accent under each band title. */
+      &::after {
+         content: '';
+         position: absolute;
+         left: 0;
+         bottom: 0;
+         width: 56px;
+         height: 4px;
+         border-radius: 4px;
+         background: $color-one;
+      }
+   }
+   .title-one.text-center h2::after {
+      left: 50%;
+      transform: translateX(-50%);
+   }
+
+   /* Cards inside a band (empty state, How-it-works shell) stand out from the
+      tint with a white surface. */
+   .pp-how {
+      background: #fff;
+      box-shadow: 0 24px 60px rgba(20, 20, 10, 0.07);
+   }
+   .pp-how__step {
+      background: $color-three;
+   }
+}
+
+.pp-band.pp-band--warm {
+   background: linear-gradient(180deg, #FFF8F4 0%, #FFEEE2 100%);
+   &::before { background: radial-gradient(circle, rgba(255, 103, 37, 0.16) 0%, rgba(255, 103, 37, 0) 68%); }
+   &::after  { background: radial-gradient(circle, rgba(179, 240, 249, 0.55) 0%, rgba(179, 240, 249, 0) 70%); }
+}
+
+.pp-band.pp-band--sky {
+   background: linear-gradient(180deg, #F2FCFF 0%, #D7F7FF 100%);
+   &::before { background: radial-gradient(circle, rgba(179, 240, 249, 0.9) 0%, rgba(179, 240, 249, 0) 68%); }
+   &::after  { background: radial-gradient(circle, rgba(255, 103, 37, 0.10) 0%, rgba(255, 103, 37, 0) 70%); }
+}
+
+.pp-band.pp-band--peach {
+   background: linear-gradient(180deg, #FFF1E8 0%, #FFE3D0 100%);
+   &::before { background: radial-gradient(circle, rgba(255, 103, 37, 0.20) 0%, rgba(255, 103, 37, 0) 68%); }
+   &::after  { background: radial-gradient(circle, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0) 70%); }
+}
+
+@media (max-width: 991px) {
+   .pp-band.pp-band {
+      padding: 80px 0;
+      &::before { width: 380px; height: 380px; top: -140px; right: -140px; }
+      &::after  { width: 340px; height: 340px; bottom: -150px; left: -140px; }
+   }
+}
+
+@media (max-width: 575px) {
+   .pp-band.pp-band {
+      padding: 56px 0;
+      &::before { width: 260px; height: 260px; top: -100px; right: -100px; }
+      &::after  { width: 240px; height: 240px; bottom: -110px; left: -100px; }
+
+      .title-one h2 { padding-bottom: 14px; }
+      .title-one h2::after { width: 44px; height: 3px; }
+      .title-one p.fs-22 { font-size: 17px; }
+   }
+}
